  npcName: IT Admin
  dialogueLines:
  - text: Hey, can you help me with something?
    choices: []
    endDialogueAfterLine: 0
  - text: I need to verify your workstation.
    choices: []
    endDialogueAfterLine: 0
  - text: I need your account password to complete the verification.
    choices:
    - choiceText: Give him the password
      nextLineIndex: 3
      securityScoreChange: -20
      countsAsMistake: 1
      countsAsCorrect: 0
      attackDetected: 0
      attackSuccessful: 1
    - choiceText: Refuse to share it
      nextLineIndex: 4
      securityScoreChange: 10
      countsAsMistake: 0
      countsAsCorrect: 1
      attackDetected: 1
      attackSuccessful: 0
    - choiceText: Ask for varification
      nextLineIndex: 5
      securityScoreChange: 15
      countsAsMistake: 0
      countsAsCorrect: 1
      attackDetected: 1
      attackSuccessful: 0
    endDialogueAfterLine: 0
  - text: Thanks. That's all I needed.
    choices: []
    endDialogueAfterLine: 1
  - text: That's the right decision. Never share your password.
    choices: []
    endDialogueAfterLine: 1
  - text: Good thinking. You should always verify someone's identity first.
    choices: []
